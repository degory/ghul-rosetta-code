<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>rosetta</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="src/**/*.ghul" />

    <!-- to rewrite an animated PNG as the GIF the wiki animates -->
    <PackageReference Include="ghul.raster" />

    <!-- Terminator-free sources; error on CI so stray `;` cannot creep
         back in, warning locally. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" Condition="'$(CI)' != ''" />
  </ItemGroup>
</Project>
