namespace Rosetta is
    use System.Text.Json.JsonSerializer
    use System.Text.Json.JsonSerializerOptions
    use System.Text.Json.Serialization.JsonIgnoreCondition
    use Collections

    // One task's standing. `title` is the Rosetta Code page title and is the key: a slug is
    // derived from it and only exists once there is a solution to hold.
    //
    // state:
    //   queued     picked to work on, not written yet
    //   solved     written, tested, not on the wiki
    //   published  on the wiki
    //   rejected   will not be attempted, `reason` says why, never revisited
    //   blocked    cannot be written yet, `reason` names the issue, revisited when it closes
    //
    // `published_hash` is the digest of the section this repository last put on the wiki. It is
    // what tells an edit made here from an edit made there: if the section on the page still
    // hashes to this, nobody has touched it since, and replacing it loses nothing.
    class TASK_ENTRY is
        title: string public
        slug: string? public
        state: string public
        reason: string? public
        note: string? public
        published_hash: string? public

        // The wiki's digest of each image this repository uploaded for the
        // task, by the name the solution wrote it under. What tells our own
        // picture from one somebody has replaced it with.
        image_hashes: MAP[string, string]? public

        init() is
            title = ""
            state = "queued"
        si
    si

    // One file per entry under ledger/, so that work on different tasks never touches the same
    // file. An entry lives at its slug, or at a key made from its title while it has none, and
    // moves when it gains one.
    class LEDGER is
        _directory: string
        _by_title: MAP[string, TASK_ENTRY]
        _loaded_from: MAP[string, string]

        _options: JsonSerializerOptions? static

        options: JsonSerializerOptions static is
            if !_options? then
                let o = JsonSerializerOptions()

                o.write_indented = true
                o.default_ignore_condition = JsonIgnoreCondition.WHEN_WRITING_NULL
                o.encoder = System.Text.Encodings.Web.JavaScriptEncoder.unsafe_relaxed_json_escaping

                _options = o
            fi

            return _options
        si

        init(directory: string) is
            _directory = directory
            _by_title = MAP[string, TASK_ENTRY]()
            _loaded_from = MAP[string, string]()

            if IO.Directory.exists(directory) then
                for path in IO.Directory.get_files(directory, "*.json") do
                    let text = IO.File.read_all_text(path)

                    if let entry = JsonSerializer.deserialize[TASK_ENTRY](text, options) then
                        _by_title[entry.title] = entry
                        _loaded_from[entry.title] = path
                    fi
                od
            fi
        si

        // A title as a file name: accents dropped, anything but a letter or digit a hyphen.
        key(title: string) -> string is
            let result = System.Text.StringBuilder()
            let decomposed = title.to_lower().normalize(System.Text.NormalizationForm.FORM_D)

            for c in decomposed do
                if (c >= 'a' /\ c <= 'z') \/ (c >= '0' /\ c <= '9') then
                    result.append(c)
                elif c < '\u0300' \/ c > '\u036F' then
                    if result.length > 0 /\ result[result.length - 1] != '-' then
                        result.append('-')
                    fi
                fi
            od

            result.to_string().trim_end('-')
        si

        path_of(entry: TASK_ENTRY) -> string =>
            IO.Path.combine(_directory, "{entry.slug ?? key(entry.title)}.json")

        count: int => _by_title.count

        has(title: string) -> bool => _by_title.contains_key(title)

        find(title: string) -> TASK_ENTRY? is
            let found: TASK_ENTRY mut

            if _by_title.try_get_value(title, found ref) then
                return found
            fi

            return null
        si

        // The entry for `title`, created in the queued state if it is not already there.
        entry(title: string) -> TASK_ENTRY is
            if let existing = find(title) then
                return existing
            fi

            let created = TASK_ENTRY()

            created.title = title

            _by_title[title] = created

            return created
        si

        // Every entry, ordered by title, so the file's diff shows only what changed.
        entries() -> LIST[TASK_ENTRY] is
            let all = LIST[TASK_ENTRY](_by_title.values)

            all.sort((a: TASK_ENTRY, b: TASK_ENTRY) -> int => string.compare_ordinal(a.title, b.title))

            return all
        si

        in_state(state: string) -> LIST[TASK_ENTRY] is
            let result = LIST[TASK_ENTRY]()

            for e in entries() do
                if e.state =~ state then
                    result.add(e)
                fi
            od

            return result
        si

        // Writes only the entries whose file would change, and fails rather than let two
        // entries share a file.
        save() is
            IO.Directory.create_directory(_directory)

            let claimed = MAP[string, string]()

            for e in entries() do
                let path = path_of(e)
                let other: string mut

                if claimed.try_get_value(path, other ref) then
                    throw System.InvalidOperationException(
                        "ledger entries '{other}' and '{e.title}' would share {path}")
                fi

                claimed[path] = e.title

                let text = "{JsonSerializer.serialize[TASK_ENTRY](e, options)}\n"
                let current = if IO.File.exists(path) then IO.File.read_all_text(path) else "" fi

                if text !~ current then
                    IO.File.write_all_text(path, text)
                fi

                let previous: string mut

                if _loaded_from.try_get_value(e.title, previous ref) /\ previous !~ path then
                    IO.File.delete(previous)
                fi

                _loaded_from[e.title] = path
            od
        si
    si
si
