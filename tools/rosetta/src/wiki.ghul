namespace Rosetta is
    use System.Net.Http;
    use System.Text.Json.JsonDocument;
    use System.Text.Json.JsonElement;
    use Collections;

    // A read and write client for the Rosetta Code MediaWiki API.
    //
    // Writing needs a credential from Special:BotPasswords on an account that can already edit.
    // The account name is `user@botname` and the password is the one that page issues once and
    // does not show again. Every edit appears in the page history under the underlying account.
    class WIKI is
        _client: HttpClient;
        _api: string;
        _csrf_token: string?;

        init(api: string) is
            _api = api;
            _client = HttpClient();

            _client.default_request_headers.add(
                "User-Agent",
                "ghul-rosetta/1.0 (https://github.com/degory/ghul-rosetta-code)"
            );
        si

        _get(query: string) -> JsonDocument is
            let body = _client.get_string_async("{_api}?{query}&format=json&formatversion=2").result;

            return JsonDocument.parse(body, _);
        si

        _post(fields: MAP[string, string]) -> JsonDocument is
            let form = LIST[KeyValuePair[string, string]]();

            for pair in fields do
                form.add(pair);
            od

            let content = FormUrlEncodedContent(form);
            let response = _client.post_async(_api, content).result;
            let body = response.content.read_as_string_async().result;

            return JsonDocument.parse(body, _);
        si

        // Every page in a category, following the continuation the API returns when the
        // membership is larger than one request can carry.
        category_members(category: string) -> LIST[string] is
            let titles = LIST[string]();
            let continue_from mut = "";

            do
                let cursor_argument =
                    if continue_from.length > 0 then
                        "&cmcontinue={System.Uri.escape_data_string(continue_from)}"
                    else
                        ""
                    fi;

                let query =
                    "action=query&list=categorymembers&cmtype=page&cmlimit=500"
                    "&cmtitle={System.Uri.escape_data_string(category)}"
                    "{cursor_argument}";

                let document = _get(query);
                let root = document.root_element;

                for member in root.get_property("query").get_property("categorymembers").enumerate_array() do
                    if let title = member.get_property("title").get_string() then
                        titles.add(title);
                    fi
                od

                let next: JsonElement mut;

                if !root.try_get_property("continue", next ref) then
                    break;
                fi

                let cursor: JsonElement mut;

                if !next.try_get_property("cmcontinue", cursor ref) then
                    break;
                fi

                continue_from = cursor.get_string() ?? "";
            od

            return titles;
        si

        // The raw wikitext of a page, or absent when the page does not exist.
        page_wikitext(title: string) -> string? is
            let document =
                _get("action=parse&prop=wikitext&page={System.Uri.escape_data_string(title)}");

            let parse: JsonElement mut;

            if !document.root_element.try_get_property("parse", parse ref) then
                return null;
            fi

            return parse.get_property("wikitext").get_string();
        si

        _token(kind: string) -> string is
            let document = _get("action=query&meta=tokens&type={kind}");

            return document.root_element
                .get_property("query")
                .get_property("tokens")
                .get_property("{kind}token")
                .get_string() ?? "";
        si

        // Signs in with a bot password and holds the edit token the session needs.
        log_in(user: string, password: string) is
            let login_token = _token("login");

            let fields = MAP[string, string]();

            fields["action"] = "login";
            fields["lgname"] = user;
            fields["lgpassword"] = password;
            fields["lgtoken"] = login_token;
            fields["format"] = "json";
            fields["formatversion"] = "2";

            let result = _post(fields).root_element.get_property("login");
            let status = result.get_property("result").get_string() ?? "";

            if status !~ "Success" then
                let reason: JsonElement mut;

                let detail =
                    if result.try_get_property("reason", reason ref) then
                        reason.to_string()
                    else
                        status
                    fi;

                throw System.Exception("could not sign in to the wiki: {detail}");
            fi

            _csrf_token = _token("csrf");
        si

        // Replaces a page's whole text. `log_in` must have run first.
        edit(title: string, text: string, summary: string) is
            assert _csrf_token? else "log_in has not run, so there is no edit token";

            let token = _csrf_token;

            let fields = MAP[string, string]();

            fields["action"] = "edit";
            fields["title"] = title;
            fields["text"] = text;
            fields["summary"] = summary;
            fields["token"] = token;
            fields["format"] = "json";
            fields["formatversion"] = "2";

            let result = _post(fields);
            let root = result.root_element;
            let error: JsonElement mut;

            if root.try_get_property("error", error ref) then
                throw System.Exception("the wiki refused the edit: {error.to_string()}");
            fi

            let status = root.get_property("edit").get_property("result").get_string() ?? "";

            if status !~ "Success" then
                throw System.Exception("the wiki did not apply the edit: {status}");
            fi
        si
    si
si
