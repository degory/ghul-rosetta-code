use default

let source = IO.File.read_all_text("entropy-narcissist.ghul")

let entropy =
    source
        |> group_by(c => c)
        |> sum_by((_, occurrences) =>
            let share =
                cast double(occurrences.count) / cast double(source.length)
            in
            -share * double.log2(share))

write_line("entropy of this source: {entropy:F6} bits per character")
