use IO.Std.write_line;

let i mut = 0;

let sum = (low: int, high: int, term: () -> double) -> double =>
    val
        let total mut = 0.0D;

        i = low;

        while i <= high do
            total = total + term();

            i = i + 1;
        od

        total
    lav;

write_line("{sum(1, 100, () => 1.0D / cast double(i))}");
