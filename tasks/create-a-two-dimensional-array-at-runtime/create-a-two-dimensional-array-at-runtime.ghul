use default

grid(rows: int, columns: int) -> LIST[LIST[int]] is
    let made = LIST()

    for _ in 1::rows do
        let row = repeat(0, columns) |> collect_list()

        made.add(row)
    od

    made
si

let dimensions = LIST([3, 4])

let values = grid(dimensions[0], dimensions[1])

values[1][2] = 7

for row in values do
    write_line(row |> join(" "))
od
