use IO.Std.write_line
use Collections.LIST
use Ghul.Pipes
use System.Numerics.BigInteger
use System.Numerics.IAdditionOperators.`+
use System.Numerics.ISubtractionOperators.`-
use System.Numerics.IMultiplyOperators.`*
use System.Numerics.IDivisionOperators.`/
use System.Numerics.IModulusOperators.`%
use System.Text.StringBuilder

digit_value(c: char) -> int =>
    case c
    when '+' then 1
    when '-' then -1
    else 0
    esac

digit_char(v: int) -> char =>
    if v == 1 then '+' elif v == -1 then '-' else '0' fi

class BT is
    _digits: string

    init(digits: string) is
        _digits = digits
    si

    from_string(s: string) -> BT static is
        BT(s)
    si

    from_big(n: BigInteger) -> BT static is
        let three = BigInteger(3)
        let chars = LIST[char]()
        let remaining mut = n
        let more mut = true

        while more do
            let r mut = cast int(remaining % three)
            if r < 0 then r = r + 3 fi
            if r == 2 then r = -1 fi

            chars.add(digit_char(r))
            remaining = (remaining - BigInteger(r)) / three
            more = remaining !~ BigInteger(0)
        od

        chars.reverse()
        BT(chars |> map(c => "{c}") |> join(""))
    si

    to_big() -> BigInteger is
        let value mut = BigInteger(0)
        let three = BigInteger(3)

        for c in _digits do
            value = value * three + BigInteger(digit_value(c))
        od

        value
    si

    to_string() -> string is
        _digits
    si

    negate() -> BT is
        let flipped = StringBuilder()

        for c in _digits do
            flipped.append(digit_char(-digit_value(c)))
        od

        BT(flipped.to_string())
    si

    +(other: BT) -> BT is
        let chars = LIST[char]()
        let carry mut = 0
        let i mut = _digits.length - 1
        let j mut = other._digits.length - 1

        while i >= 0 \/ j >= 0 \/ carry != 0 do
            let sum mut = carry

            if i >= 0 then
                sum = sum + digit_value(_digits[i])
                i = i - 1
            fi

            if j >= 0 then
                sum = sum + digit_value(other._digits[j])
                j = j - 1
            fi

            let d mut = sum % 3
            if d < 0 then d = d + 3 fi
            if d == 2 then d = -1 fi
            carry = (sum - d) / 3
            chars.add(digit_char(d))
        od

        while chars.count > 1 /\ chars[chars.count - 1] == '0' do
            chars.remove_at(chars.count - 1)
        od

        chars.reverse()
        BT(chars |> map(c => "{c}") |> join(""))
    si

    -(other: BT) -> BT is
        self + other.negate()
    si

    *(other: BT) -> BT is
        let product mut = BT("0")

        for i in 0.._digits.length do
            let d = digit_value(_digits[_digits.length - 1 - i])

            if d != 0 then
                let shifted = StringBuilder(other._digits)

                for _ in 1::i do
                    shifted.append('0')
                od

                let term = BT(shifted.to_string())
                product = product +
                    (if d == 1 then term else term.negate() fi)
            fi
        od

        product
    si
si

let a = BT.from_string("+-0++0+")
let b = BT.from_big(BigInteger(-436))
let c = BT.from_string("+-++-")

write_line("a = {a.to_big()}")
write_line("b = {b.to_big()}")
write_line("c = {c.to_big()}")

let result = a * (b - c)
write_line("a * (b - c) = {result} = {result.to_big()}")
