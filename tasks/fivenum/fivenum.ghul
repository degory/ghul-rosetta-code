use default

fivenum(xs_raw: double[]) -> double[] is
    let xs = xs_raw |> sort() |> collect_array()
    let n = xs.count
    let n4 = System.Math.floor((cast double(n) + 3.0) / 2.0) / 2.0
    let d = [1.0, n4, (cast double(n) + 1.0) / 2.0, cast double(n) + 1.0 - n4, cast double(n)]

    d |> map(di => 0.5 * (xs[cast int(System.Math.floor(di)) - 1] + xs[cast int(System.Math.ceiling(di)) - 1])) |> collect_array()
si

for xs in [[15.0, 6.0, 42.0, 41.0, 7.0, 36.0, 49.0, 40.0, 39.0, 47.0, 43.0], [36.0, 40.0, 7.0, 39.0, 41.0, 15.0]] do
    write_line("data: {xs |> map(x => "{x}") |> join(", ")}")
    write_line("fivenum: {fivenum(xs) |> map(x => "{x}") |> join(", ")}")
od
