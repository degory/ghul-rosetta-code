use default

counts(s: string) -> Map[char, int] is
    let tally = MAP[char, int]()

    for c in s do
        tally[c] = (if tally.contains_key(c) then tally[c] else 0 fi) + 1
    od

    tally
si

show(strings: string[]) is
    let tallies = strings |> map(counts) |> collect_list()
    let specific = LIST[int]()
    let others = LIST[int]()

    for i in 0..strings.count do
        let chars = tallies[i].keys |> collect_list()
        let elsewhere = (c: char) =>
            0..strings.count
                |> any(j => j != i /\ tallies[j].contains_key(c))
        let passes =
            chars |> count(c => tallies[i][c] == 2 /\ !elsewhere(c))

        specific.add(passes)
        others.add(chars.count - passes)
    od

    write_line("[{strings |> map(s => "\"{s}\"") |> join(", ")}]")
    write_line("    specific: [{specific |> join(", ")}]")
    write_line("    not:      [{others |> join(", ")}]")
si

show(["ahwiueshaiu", "ajxxfioaaf", "ajrdsfroiwr"])
show(["aabbcc", "abcdd", "eeff"])
