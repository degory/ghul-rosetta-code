use default

is_prime(n: int) -> bool is
    if n < 2 then
        return false
    elif n % 2 == 0 then
        return n == 2
    fi

    let factor mut = 3

    while factor * factor <= n do
        if n % factor == 0 then
            return false
        fi

        factor = factor + 2
    od

    return true
si

let found mut = 0

for p1 in 2::61 do
    if !is_prime(p1) then
        continue
    fi

    for h3 in 2..p1 do
        let sum = h3 + p1

        for d in 1..sum do
            if (sum * (p1 - 1)) % d != 0 then
                continue
            elif ((-p1 * p1) % h3 + h3) % h3 != d % h3 then
                continue
            fi

            let p2 = 1 + (p1 - 1) * sum / d

            if !is_prime(p2) then
                continue
            fi

            let p3 = 1 + p1 * p2 / h3

            if !is_prime(p3) \/ (p2 * p3) % (p1 - 1) != 1 then
                continue
            fi

            found = found + 1

            write_line("{p1,4} x {p2,5} x {p3,6} = {p1 * p2 * p3,10}")
        od
    od
od

write_line("")
write_line("{found} Carmichael numbers")
