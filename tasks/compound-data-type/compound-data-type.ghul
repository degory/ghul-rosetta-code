use IO.Std.write_line

// A struct is a value type, so a copy is a separate point.
struct POINT(x: int, y: int);

let origin = POINT(0, 0)
let corner = POINT(3, 4)

write_line("origin ({origin.x}, {origin.y})")
write_line("corner ({corner.x}, {corner.y})")
write_line("the two points are {if origin =~ corner then "equal" else "different" fi}")
