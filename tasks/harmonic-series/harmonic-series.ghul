use default

harmonic_numbers() -> Ghul.Pipes.Pipe[(n: int, value: double)] is
    let sum mut = 0.0
    let n mut = 1

    do
        sum = sum + 1.0 / cast double(n)
        yield (n = n, value = sum)
        n = n + 1
    od
si

write_line("first 20 harmonic numbers:")

for h in harmonic_numbers() |> take(20) do
    write_line("H({h.n}) = {h.value,0:F6}")
od

write_line("")
write_line("first position where H(n) exceeds a given integer:")

for threshold in 1::10 do
    if let hit = harmonic_numbers() |> filter(h => h.value > cast double(threshold)) |> first() then
        write_line("H(n) > {threshold} first at n = {hit.n}")
    fi
od
