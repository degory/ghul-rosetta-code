use System.Math
use Raster.IMAGE

let turns = 5.0D
let steps = 2000

let last = turns * 2.0D * Math.pi

let image = IMAGE(400, 400)

// The spiral is stated in the plane it is drawn in, so the picture is
// described in the same terms as the curve.
image.view(-last, -last, last, last)

image.colour(0ub, 0ub, 160ub)
image.stroke(1.5D)

at(angle: double) -> (x: double, y: double) =>
    (x = angle * Math.cos(angle), y = angle * Math.sin(angle))

for step in 0..steps do
    let from = at(last * cast double(step) / cast double(steps))
    let to = at(last * cast double(step + 1) / cast double(steps))

    image.line(from.x, from.y, to.x, to.y)
od

image.write("spiral.png")

image.show("spiral.png")
