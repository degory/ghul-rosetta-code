#!/bin/bash

# The time differs on every run, so what is asserted is the digits, and that
# a time was reported. The first line says the computation has started, and is
# there so the playground shows something while it runs.

expected="3.141592653589793238462643383279 ... 399634646042209010610577945815
999999 decimal places"

if [ "$(sed -n 2,3p "$1")" != "$expected" ]; then
    echo "the digits are wrong:"
    cat "$1"

    exit 1
fi

if ! sed -n 4p "$1" | grep -qE '^computed in [0-9]+\.[0-9]{2} seconds$'; then
    echo "the last line should give the time taken:"
    cat "$1"

    exit 1
fi
