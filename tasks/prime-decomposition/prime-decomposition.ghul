use IO.Std.write_line
use Collections
use Ghul.Pipes

decompose(n: bigint) -> List[bigint] is
    let factors = LIST()

    let two = 2n
    let rest mut = n

    while rest % two =~ bigint.zero do
        factors.add(two)
        rest = rest / two
    od

    let divisor mut = 3n

    while divisor * divisor <= rest do
        if rest % divisor =~ bigint.zero then
            factors.add(divisor)
            rest = rest / divisor
        else
            divisor = divisor + two
        fi
    od

    if rest > bigint.one then
        factors.add(rest)
    fi

    return factors
si

show(n: bigint) is
    let rendered = LIST()

    for factor in decompose(n) do
        rendered.add("{factor}")
    od

    write_line("{n} = {rendered |> join(" x ")}")
si

for n in [12L, 2L, 9L, 1024L, 1048576L, 4294967297L, 1234567890L] do
    show(cast(n))
od

show(bigint.parse("12345678901234567890"))
