use IO.Std.write_line;
use Ghul.Pipes;

apply[T, U](values: T[], callback: T -> U pure) -> U[] =>
    values |> map(callback) |> collect_array();

let squares = [1, 2, 3, 4, 5] |> apply(x => x * x);

write_line(squares |> map(x => "{x}") |> join(" "));

shout(word: string) -> string => "{word.to_upper()}!";

// The callback is an ordinary value, so a named function goes in the same slot as a literal.
write_line(["frog", "newt"] |> apply(shout) |> join(" "));
