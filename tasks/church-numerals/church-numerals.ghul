use IO.Std.write_line;

// A Church numeral over T applies its first argument to its second T times,
// so it has type ((T) -> T) -> (T) -> T. Exponentiation is what forces the
// type parameter: a^b is b applied to a, which type-checks only when b is a
// numeral over (int) -> int rather than over int.

zero[T](f: (T) -> T) -> (T) -> T => x => x;

successor[T](n: ((T) -> T) -> (T) -> T) -> ((T) -> T) -> (T) -> T =>
    f => x => f(n(f)(x));

add[T](
    a: ((T) -> T) -> (T) -> T,
    b: ((T) -> T) -> (T) -> T
) -> ((T) -> T) -> (T) -> T =>
    f => x => a(f)(b(f)(x));

multiply[T](
    a: ((T) -> T) -> (T) -> T,
    b: ((T) -> T) -> (T) -> T
) -> ((T) -> T) -> (T) -> T =>
    f => a(b(f));

exponentiate(
    a: ((int) -> int) -> (int) -> int,
    b: (((int) -> int) -> (int) -> int) -> ((int) -> int) -> (int) -> int
) -> ((int) -> int) -> (int) -> int =>
    b(a);

to_church[T](n: int) -> ((T) -> T) -> (T) -> T =>
    if n == 0 then zero[T] else successor(to_church[T](n - 1)) fi;

to_int(n: ((int) -> int) -> (int) -> int) -> int => n(x => x + 1)(0);

let three = successor(successor(successor(zero[int])));
let four = successor(three);

write_line("three is {to_int(three)}");
write_line("four is {to_int(four)}");
write_line("three plus four is {to_int(add(three, four))}");
write_line("three times four is {to_int(multiply(three, four))}");
write_line("four to the power three is {to_int(exponentiate(four, to_church[(int) -> int](3)))}");
write_line("three to the power four is {to_int(exponentiate(three, to_church[(int) -> int](4)))}");
