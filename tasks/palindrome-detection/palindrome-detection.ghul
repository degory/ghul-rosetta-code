use wl = IO.Std.write_line;
use Ghul.Collections;
use Ghul.Pipes;

reverse(s: string) -> string =>
    s |> reduce("", (acc, c) => "{c}{acc}");

is_palindrome(s: string) -> bool => s =~ reverse(s);

// ignores non-letters and folds case
is_inexact_palindrome(s: string) -> bool =>
    s 
        |> filter(char.is_letter)
        |> map(char.to_lower)
        |> reduce("", (acc, c) => "{acc}{c}")
        |> is_palindrome();

test(maybe_palindrome: string, palindrome_check: string -> bool) -> string =>
    if palindrome_check(maybe_palindrome) then
        "\"{maybe_palindrome}\" is a palindrome"
    else
        "\"{maybe_palindrome}\" is not a palindrome"
    fi;

wl(test("racecar", is_palindrome));
wl(test("hello", is_palindrome));
wl(test("rotor", is_palindrome));

wl(test("A man, a plan, a canal: Panama", is_inexact_palindrome));
wl(test("race car", is_inexact_palindrome));
wl(test("hello world", is_inexact_palindrome));
