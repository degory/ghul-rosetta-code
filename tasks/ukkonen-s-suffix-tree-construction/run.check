#!/bin/bash

# The times differ on every run, so what is asserted is everything else:
# the longest repeats, and that each size reported a time.

expected="GEEKSFORGEEKS   GEEKS
AAAAAAAAAA      AAAAAAAAA
ABCDEFG         (none)
banana          ana
ATCGATCGA       ATCGA

first   1,000 digits: longest repeat 23846
first  10,000 digits: longest repeat 7111369
first 100,000 digits: longest repeat 041021944"

if [ "$(grep -v 'built and searched in' "$1")" != "$expected" ]; then
    echo "the repeats are wrong:"
    cat "$1"

    exit 1
fi

if [ "$(grep -cE '^    built and searched in [0-9]+\.[0-9] ms$' "$1")" != "3" ]; then
    echo "each size should report the time it took:"
    cat "$1"

    exit 1
fi
