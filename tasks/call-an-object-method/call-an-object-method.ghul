use default

class GREETER is
    greeting: string static

    init() static is
        greeting = "hello"
    si

    name: string

    init(name: string) is
        self.name = name
    si

    greet() -> string => "{GREETER.greeting}, {name}"

    greet_twice() -> string => "{greet()} and again: {greet()}"

    +(other: GREETER) -> GREETER => GREETER("{name} and {other.name}")
si

let greeter = GREETER("world")

write_line(greeter.greet())
write_line(greeter.greet_twice())
write_line(GREETER.greeting)
write_line((greeter + GREETER("everyone")).greet())
write_line(greeter. +(GREETER("you")).greet())

let greet = greeter.greet

write_line("through a function value: {greet()}")
