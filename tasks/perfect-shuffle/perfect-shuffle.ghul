use default

shuffle(deck: List[int]) -> List[int] =>
    let half = deck.count / 2 in
    0..deck.count
        |> map(i =>
            if i % 2 == 0 then deck[i / 2] else deck[half + i / 2] fi)
        |> collect_list()

shuffles_needed(size: int) -> int is
    let original = 0..size |> collect_list()
    let deck mut = shuffle(original)
    let count mut = 1

    while deck !~ original do
        deck = shuffle(deck)
        count = count + 1
    od

    count
si

for size in [8, 24, 52, 100, 1020, 1024, 10000] do
    write_line("{size,5} cards: {shuffles_needed(size),4} shuffles")
od
