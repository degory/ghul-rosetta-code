use IO.Std.write_line;

// The untyped Y combinator applies its argument to itself, and `x x` has no type in a language
// without recursive types. A class whose field takes the class itself supplies one: SELF_APPLY[A, B]
// stands for the type "function from itself to A -> B".
class SELF_APPLY[A, B] is
    _f: (SELF_APPLY[A, B]) -> (A -> B);

    init(f: (SELF_APPLY[A, B]) -> (A -> B)) is
        _f = f;
    si

    apply(r: SELF_APPLY[A, B]) -> (A -> B) => _f(r);
si

// Y f = (\x. f (x x)) (\x. f (x x)), with the inner application deferred behind `a =>` so that
// evaluation terminates under call-by-value.
y[A, B](f: (A -> B) -> (A -> B)) -> (A -> B) is
    let wrap = SELF_APPLY[A, B]((r: SELF_APPLY[A, B]) => (a: A) => f(r.apply(r))(a));

    return wrap.apply(wrap);
si

let factorial = y[int, long](recurse => n => if n <= 1 then 1L else cast(n) * recurse(n - 1) fi);
let fibonacci = y[int, int](recurse => n => if n < 2 then n else recurse(n - 1) + recurse(n - 2) fi);

// The combinator is generic, so the same definition builds a function over any argument and
// result type: this one counts the characters of a spelled-out number by recursion.
let describe = y[int, string](recurse => n => if n <= 0 then "" else "{recurse(n - 1)}*" fi);

for n in 1::10 do
    write_line("factorial({n}) = {factorial(n)}, fibonacci({n}) = {fibonacci(n)}, describe({n}) = {describe(n)}");
od
