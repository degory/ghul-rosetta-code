use default

is_square_free(n: long) -> bool is
    if n % 4L == 0L then
        return false
    fi

    let d mut = 3L

    while d * d <= n do
        if n % (d * d) == 0L then
            return false
        fi

        d = d + 2L
    od

    true
si

show(from: long, to: long) is
    let found = from::to |> filter(is_square_free) |> collect_mutable()
    let width = "{to}".length + 1
    let per_row = 72 / width

    write_line("Square-free integers from {from:N0} to {to:N0}:")

    for row in 0..(found.count + per_row - 1) / per_row do
        let cells = found |> skip(row * per_row) |> take(per_row)

        write_line(cells |> map(n => "{n}".pad_left(width)) |> join(""))
    od

    write_line("")
si

show(1L, 145L)
show(1_000_000_000_000L, 1_000_000_000_145L)

let limit = 1_000_000
let square_free = repeat(true, limit + 1) |> collect_mutable()

for d in 2::1000 do
    let square = d * d
    let multiple mut = square

    while multiple <= limit do
        square_free[multiple] = false
        multiple = multiple + square
    od
od

let count mut = 0
let next mut = 100

for n in 1::limit do
    if square_free[n] then
        count = count + 1
    fi

    if n == next then
        write_line("up to {n,9:N0}: {count,7:N0}")
        next = next * 10
    fi
od
