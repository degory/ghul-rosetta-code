use default

pyramid(base: List[int]) -> List[List[int]] is
    let rows = LIST[List[int]]([base])

    while rows[0].count > 1 do
        let below = rows[0]
        let above = 0..below.count - 1
            |> map(i => below[i] + below[i + 1])
            |> collect()

        rows.insert(0, above)
    od

    rows
si

let solutions = 0::151
    |> flat_map(x => 0::151 |> map(z => (x, z)))
    |> map(((x, z)) => pyramid([x, 11, x + z, 4, z]))
    |> filter(p => p[0][0] == 151 /\ p[2][0] == 40)

for p in solutions do
    for (depth, row) in p |> index() do
        let indent = string(' ', (p.count - 1 - depth) * 3)
        write_line("{indent}{row |> map(v => "[{v,4}]") |> join("")}")
    od

    write_line()
    write_line("X = {p[4][0]}, Y = {p[4][2]}, Z = {p[4][4]}")
od
