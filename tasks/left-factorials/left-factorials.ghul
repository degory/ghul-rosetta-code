use IO.Std.write_line;
use Ghul.Pipes;
use System.Numerics.BigInteger;
use System.Numerics.IAdditionOperators.`+;
use System.Numerics.IMultiplyOperators.`*;

left_factorials() -> Ghul.Pipes.Pipe[BigInteger] =>
    stream(
        (n = 0, factorial = BigInteger.one, total = BigInteger.zero),
        ((n, factorial, total)) =>
            total || (n + 1, factorial * cast(n + 1), total + factorial)
    );

write_line("left factorials !0 through !10, then every tenth up to !110:");

left_factorials()
    |> index()
    |> take_while(((n, _)) => n <= 110)
    |> filter(((n, _)) => n <= 10 \/ (n >= 20 /\ n % 10 == 0))
    |> each(((n, left)) => write_line("!{n} = {left}"));

write_line("digit counts of !1000 through !10000, by thousands:");

left_factorials()
    |> index()
    |> take_while(((n, _)) => n <= 10000)
    |> filter(((n, _)) => n >= 1000 /\ n % 1000 == 0)
    |> each(((n, left)) => write_line("!{n} has {left.to_string().length} digits"));
