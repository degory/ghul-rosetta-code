// Each philosopher takes the lower-numbered of its two forks
// first, so no cycle of philosophers can each hold one fork and
// wait for the next: the table cannot deadlock.

use IO.Std.write_line
use Ghul.Coroutines.COROUTINE
use Ghul.Coroutines.SCHEDULER

forks: Collections.LIST[bool]

dine(scheduler: SCHEDULER, name: string, seat: int) -> COROUTINE is
    let left = seat
    let right = (seat + 1) % forks.count
    let lower = if left < right then left else right fi
    let higher = if left < right then right else left fi

    for _ in 1::2 do
        write_line("{name} is thinking")
        await scheduler.pause()

        for fork in [lower, higher] do
            while forks[fork] do
                await scheduler.pause()
            od

            forks[fork] = true
        od

        write_line("{name} eats with forks {lower} and {higher}")
        await scheduler.pause()

        forks[lower] = false
        forks[higher] = false

        write_line("{name} puts the forks down")
    od

    return
si

let philosophers =
    ["Aristotle", "Kant", "Spinoza", "Marx", "Russell"]

forks = Collections.LIST[bool]()

for seat in 0..philosophers.count do
    forks.add(false)
od

let scheduler = SCHEDULER()

for seat in 0..philosophers.count do
    scheduler.spawn(s => dine(s, philosophers[seat], seat))
od

scheduler.run()
