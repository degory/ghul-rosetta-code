use IO.Std.write_line
use System.Math
use Ghul.Pipes.map
use Ghul.Pipes.reduce
use Ghul.Pipes.collect_array

arithmetic(values: double[]) -> double is
    let total = values |> reduce(0.0, (running, v) => running + v)

    return total / cast double(values.count)
si

geometric(values: double[]) -> double is
    let product = values |> reduce(1.0, (running, v) => running * v)

    return Math.pow(product, 1.0 / cast double(values.count))
si

harmonic(values: double[]) -> double is
    let reciprocals =
        values |> reduce(0.0, (running, v) => running + 1.0 / v)

    return cast double(values.count) / reciprocals
si

let one_to_ten = (1::10) |> map(n => cast double(n)) |> collect_array()

let a = arithmetic(one_to_ten)
let g = geometric(one_to_ten)
let h = harmonic(one_to_ten)

write_line("arithmetic {a}")
write_line("geometric  {g}")
write_line("harmonic   {h}")
write_line("A >= G >= H holds: {a >= g /\ g >= h}")
