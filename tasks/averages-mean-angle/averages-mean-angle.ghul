use default

mean_angle(degrees: List[double]) -> double =>
    let radians =
        degrees
            |> map(d => double.degrees_to_radians(d))
    in
    let sines = radians |> map(r => double.sin(r)) |> sum() in
    let cosines = radians |> map(r => double.cos(r)) |> sum() in
    double.radians_to_degrees(double.atan2(sines, cosines))

let lists = [[350.0, 10.0], [90.0, 180.0, 270.0, 360.0], [10.0, 20.0, 30.0]]

for angles in lists do
    write_line("mean angle of {angles} is {mean_angle(angles):F4} degrees")
od
