use IO.Std.write_line;

// The task requires that an accumulator given only whole numbers returns whole numbers. So a
// total is either whole or fractional, and adding a fractional value to it makes it fractional
// from then on.
union NUMBER is
    WHOLE(value: int);
    FRACTIONAL(value: double);
si

use NUMBER.WHOLE;
use NUMBER.FRACTIONAL;

widen(n: NUMBER) -> double =>
    case n
    when (value): WHOLE then cast double(value)
    when (value): FRACTIONAL then value
    esac;

add(left: NUMBER, right: NUMBER) -> NUMBER =>
    if let l: WHOLE = left, r: WHOLE = right then
        WHOLE(l.value + r.value)
    else
        FRACTIONAL(widen(left) + widen(right))
    fi;

show(n: NUMBER) -> string =>
    case n
    when (value): WHOLE then "{value}"
    when (value): FRACTIONAL then "{value}"
    esac;

// Every call gets its own sum. A `let mut` is captured by reference, so the returned function
// adds to that same total each time it is called, and nothing else can read or change it.
accumulator(initial: NUMBER) -> NUMBER -> NUMBER is
    let sum mut = initial;

    return i =>
        val
            sum = add(sum, i);
            sum
        lav;
si

let x = accumulator(WHOLE(1));

x(WHOLE(5));

// The task's example builds a second accumulator at this point, to show that doing so leaves the
// first one alone.
accumulator(WHOLE(3));

write_line(show(x(FRACTIONAL(2.3D))));

// y has only ever been given whole numbers, so its total prints as 20 rather than 20.0.
let y = accumulator(WHOLE(10));

y(WHOLE(5));

write_line(show(y(WHOLE(5))));
