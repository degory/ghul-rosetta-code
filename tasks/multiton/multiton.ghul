use IO.Std.write_line;
use Collections.MAP;

// A singleton controls creation of one instance; a multiton controls creation of one per key. The
// map and the factory are all that differ, so neither needs to be written again for each type
// managed this way: the key and the instance are type parameters, and how to make one is an
// argument.
// Taking the monitor in the constructor and releasing it on disposal makes the lock a scope:
// `let use` ends it however the block is left, including by an early return.
class HOLDING: Ghul.Disposable is
    _guard: object;

    init(guard: object) is
        _guard = guard;

        System.Threading.Monitor.enter(_guard);
    si

    dispose() is
        System.Threading.Monitor.exit(_guard);
    si
si

class MULTITON[K, V] is
    _create: K -> V;
    _instances: MAP[K, V];
    _guard: object;

    init(create: K -> V) is
        _create = create;
        _instances = MAP();
        _guard = object();
    si

    // The instance for this key, made on the first request for it and shared by every request
    // after that.
    //
    // The lookup and the store have to be one step. Without that, two callers arriving together
    // both find the key absent, both build an instance, and the second overwrites the first -
    // leaving two instances for a key that is supposed to have one, and callers holding whichever
    // they were given.
    get(key: K) -> V is
        let use holding = HOLDING(_guard);

        let existing: V mut;

        if _instances.try_get_value(key, existing ref) then
            return existing;
        fi

        let created = _create(key);

        _instances[key] = created;

        return created;
    si

    count: int => _instances.count;
si

class CONNECTION(host: string) is
    to_string() -> string => "connection to {host}";
si

let made mut = 0;

let connections =
    MULTITON(
        host =>
            val
                made = made + 1;

                CONNECTION(host)
            lav
    );

let alpha = connections.get("alpha");
let beta = connections.get("beta");
let alpha_again = connections.get("alpha");

write_line("{alpha}");
write_line("{beta}");

write_line("asking twice for alpha gives the same object: {alpha == alpha_again}");
write_line("alpha and beta are different objects: {alpha != beta}");
write_line("requests: 3, instances made: {made}, instances held: {connections.count}");

// The count is the property at stake, so it is worth asking for under contention: many callers
// at once, over a handful of keys. One instance per key is the answer whatever the interleaving,
// which is what the lock is for.
let shared mut = 0;

let pool =
    MULTITON(
        host =>
            val
                shared = shared + 1;

                CONNECTION(host)
            lav
    );

let keys = ["one", "two", "three"];

Tasks.Parallel.for(
    0,
    300,
    i =>
        val
            let _ = pool.get(keys[i % keys.count]);
        lav
);

write_line("300 requests over {keys.count} keys, in parallel: {shared} instances made");
