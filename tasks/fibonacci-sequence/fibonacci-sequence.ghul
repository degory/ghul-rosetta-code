use IO.Std.write_line;
use Ghul.Pipes.Pipe;

fibonacci() -> Pipe[long] is
    let current mut = 0L;
    let next mut = 1L;

    while true do
        yield current;

        let following = current + next;
        current = next;
        next = following;
    od
si

for f in fibonacci() | .take(10) do
    write_line("{f}");
od
