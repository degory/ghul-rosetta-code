use default

let digits = 100
let guard = 12

power_of_ten(n: int) -> bigint is
    let value mut = 1n

    for _ in 0..n do
        value = value * 10n
    od

    return value
si

factorial(n: int) -> bigint is
    let value mut = 1n

    for i in 2::n do
        value = value * bigint(i)
    od

    return value
si

let scale = power_of_ten(digits + guard)

show(label: string, scaled: bigint) is
    let text = (scaled / power_of_ten(guard)).to_string()

    write_line(label)
    write_line("{text[0..1]}.{text[1..text.length]}")
    write_line("")
si

reciprocal_cubes(terms: int) -> bigint is
    let total mut = 0n

    for k in 1::terms do
        let cube = bigint(k) * bigint(k) * bigint(k)

        total = total + scale / cube
    od

    return total
si

markov(terms: int) -> bigint is
    let total mut = 0n

    for k in 1::terms do
        let numerator = factorial(k) * factorial(k) * scale
        let cube = bigint(k) * bigint(k) * bigint(k)
        let denominator = factorial(2 * k) * cube
        let term = numerator / denominator

        total = if k % 2 == 1 then total + term else total - term fi
    od

    return 5n * total / 2n
si

wedeniwski(terms: int) -> bigint is
    let total mut = 0n

    for k in 0::terms do
        let n = bigint(k)

        let polynomial =
            126392n * n * n * n * n * n +
            412708n * n * n * n * n +
            531578n * n * n * n +
            336367n * n * n +
            104000n * n +
            12463n

        let odd = factorial(2 * k + 1)
        let even = factorial(2 * k)
        let plain = factorial(k)

        let numerator =
            odd * odd * odd * even * even * even *
            plain * plain * plain * polynomial
        let lower = factorial(4 * k + 3)
        let denominator = factorial(3 * k + 2) * lower * lower * lower
        let term = numerator * scale / denominator

        total = if k % 2 == 0 then total + term else total - term fi
    od

    return total / 24n
si

show("1000 terms of the sum of reciprocal cubes:", reciprocal_cubes(1000))
show("158 terms of the Markov representation:", markov(158))
show("21 terms of the Wedeniwski representation:", wedeniwski(21))
