a.b.c* (postfix ab.c*.)
    ""       false
    "abc"    true
    "abbc"   false
    "abcc"   true
    "abad"   false
    "abbbc"  false

a.(b|d).c* (postfix abd|.c*.)
    ""       false
    "abc"    true
    "abbc"   false
    "abcc"   true
    "abad"   false
    "abbbc"  false

(a.(b|d))* (postfix abd|.*)
    ""       true
    "abc"    false
    "abbc"   false
    "abcc"   false
    "abad"   true
    "abbbc"  false

a.(b.b)*.c (postfix abb.*.c.)
    ""       false
    "abc"    false
    "abbc"   true
    "abcc"   false
    "abad"   false
    "abbbc"  false

a.b+.c? (postfix ab+.c?.)
    ""       false
    "abc"    true
    "abbc"   true
    "abcc"   false
    "abad"   false
    "abbbc"  true

