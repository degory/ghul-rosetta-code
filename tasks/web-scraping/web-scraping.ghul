use default
use System.Net.Http.HttpClient
use System.Text.RegularExpressions.Regex

// The task: fetch a page and pull just the UTC time out of its HTML.
utc_time(url: string) -> string? is
    let page = HttpClient().get_string_async(url).result
    let found = Regex.match(page, "(\\d\\d:\\d\\d:\\d\\d)</span> UTC")

    if found.success then "{found.groups[1].value} UTC" else null fi
si

let found = utc_time("https://www.utctime.net/")

write_line(found ?? "no UTC time on the page")
