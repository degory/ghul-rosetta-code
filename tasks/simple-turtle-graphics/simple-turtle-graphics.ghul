use Collections.List
use Ghul.Pipes
use Raster.IMAGE
use Raster.TURTLE

let image = IMAGE(640, 360)

let pen = TURTLE(image)

house(size: double) is
    let x = pen.x
    let y = pen.y
    let heading = pen.heading

    for _ in 0..4 do
        pen.forward(size)
        pen.turn(90.0D)
    od

    pen.pen_up()
    pen.turn(90.0D)
    pen.forward(size)
    pen.turn(-90.0D)
    pen.pen_down()

    pen.turn(60.0D)
    pen.forward(size)
    pen.turn(-120.0D)
    pen.forward(size)

    pen.move_to(x, y)
    pen.face(heading)
si

bar_chart(values: List[double], size: double) is
    let x = pen.x
    let y = pen.y
    let heading = pen.heading

    let tallest =
        values |> reduce(0.0D, (most, value) =>
            if value > most then value else most fi)

    let width = size / cast double(values.count)

    for value in values do
        let height = size * value / tallest

        pen.turn(90.0D)
        pen.forward(height)
        pen.turn(-90.0D)
        pen.forward(width)
        pen.turn(-90.0D)
        pen.forward(height)
        pen.turn(90.0D)
    od

    pen.move_to(x, y)
    pen.face(heading)
si

image.view(0.0D, 0.0D, 640.0D, 360.0D)

image.colour(140ub, 60ub, 40ub)
image.stroke(3.0D)

pen.move_to(70.0D, 30.0D)
pen.face(0.0D)

house(160.0D)

image.colour(40ub, 90ub, 160ub)

pen.move_to(370.0D, 30.0D)
pen.face(0.0D)

bar_chart([3.0D, 7.0D, 1.0D, 5.0D, 9.0D, 4.0D] |> collect_list(), 220.0D)

image.write("turtle.png")

image.show("turtle.png")
