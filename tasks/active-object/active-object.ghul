use default
use System.Diagnostics.Stopwatch
use System.Math.abs
use System.Math.pi
use System.Math.sin
use System.Threading.Thread

let frequency = 0.5D

class INTEGRATOR is
    _clock: Stopwatch
    _worker: Thread
    _input: (double) -> double
    _output: double
    _previous: double
    _last: double
    _running: bool

    init() is
        _input = t => 0.0D
        _clock = Stopwatch.start_new()
        _running = true
        _worker = Thread(() => _integrate())

        _worker.is_background = true
        _worker.start()
    si

    _integrate() is
        while _running do
            Thread.sleep(1)

            let now = _clock.elapsed.total_seconds
            let sample = _input(now)

            _output = _output + (sample + _previous) * (now - _last) / 2.0D
            _previous = sample
            _last = now
        od
    si

    input(k: (double) -> double) is
        _previous = k(_clock.elapsed.total_seconds)
        _input = k
    si

    output: double => _output

    stop() is
        _running = false

        _worker.join()
    si
si

let integrator = INTEGRATOR()

integrator.input(t => sin(2.0D * pi * frequency * t))

Thread.sleep(1000)

let half_way = integrator.output

Thread.sleep(1000)

integrator.input(t => 0.0D)

Thread.sleep(500)

integrator.stop()

write_line("output half way through the sine is above 0.5: {half_way > 0.5D}")
write_line("output is within 0.01 of zero: {abs(integrator.output) < 0.01D}")
