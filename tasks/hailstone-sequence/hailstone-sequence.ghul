use IO.Std.write_line;
use Collections.LIST;
use Ghul.Pipes;

// Generates a hailstone sequence by applying the Collatz
// rule until it reaches 1.
hailstone(n: int) -> Pipe[int] is
    let current mut = n;

    while true do
        yield current;

        if current == 1 then
            return;
        fi

        current = if current % 2 == 0 then current / 2 else 3 * current + 1 fi;
    od
si

// The Collatz sequence for 27: 112 elements, starting 27, 82, 41,
// 124 and ending 8, 4, 2, 1.
let sequence = hailstone(27) | .collect_list();
write_line("length of hailstone(27): {sequence.count}");
write_line("first four: {sequence[0]}, {sequence[1]}, {sequence[2]}, {sequence[3]}");
write_line("last four: {sequence[sequence.count - 4]}, {sequence[sequence.count - 3]}, {sequence[sequence.count - 2]}, {sequence[sequence.count - 1]}");

// The number under 100,000 with the longest sequence,
// and that sequence's length.
let longest mut = 0;
let longest_length mut = 0;

for n in 1..100_000 do
    let length = hailstone(n) | .count();

    if length > longest_length then
        longest = n;
        longest_length = length;
    fi
od

write_line("longest under 100,000: {longest} (length {longest_length})");
