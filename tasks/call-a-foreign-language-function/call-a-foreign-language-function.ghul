use IO.Std.write_line;
use System.Reflection.Emit;
use System.Runtime.InteropServices;

// ghūl compiles to .NET but has no syntax for declaring a foreign function, so one is
// reached the way the runtime reaches any address: look the export up in the loaded
// library, and build a stub that calls it. Both C functions used here take a single
// pointer, so that is the only shape bind has to handle.
bind(library: word, name: string, result: System.Type?) -> System.Delegate is
    let pointer = System.Type.get_type("System.IntPtr")!;
    let address = NativeLibrary.get_export(library, name);

    let stub = DynamicMethod(name, result, [pointer]);

    let il = stub.get_i_l_generator();
    il.emit(OpCodes.ldarg_0);
    il.emit(OpCodes.ldc_i8, cast long(address));
    il.emit(OpCodes.conv_i);
    il.emit_calli(OpCodes.calli, CallingConvention.CDECL, result, [pointer]);
    il.emit(OpCodes.ret);

    if result? then
        return stub.create_delegate(System.Type.get_type("System.Func`2")!.make_generic_type([pointer, result]));
    fi

    return stub.create_delegate(System.Type.get_type("System.Action`1")!.make_generic_type([pointer]));
si

// the library's file name is the only part of this that is specific to Linux
let libc = NativeLibrary.load("libc.so.6");

let strdup = cast (word) -> word (bind(libc, "strdup", System.Type.get_type("System.IntPtr")));
let free = cast (word) -> void (bind(libc, "free", null));

// strdup wants a NUL-terminated byte string, so the .NET string is copied out to one
let source = Marshal.string_to_h_global_ansi("Hello World!");
let copy = strdup(source);

write_line(Marshal.ptr_to_string_ansi(copy));

// each pointer goes back to whichever allocator produced it
free(copy);
Marshal.free_h_global(source);
