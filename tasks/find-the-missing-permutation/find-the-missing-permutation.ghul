use default

let given =
    [
        "ABCD", "CABD", "ACDB", "DACB", "BCDA", "ACBD", "ADCB", "CDAB",
        "DABC", "BCAD", "CADB", "CDBA", "CBAD", "ABDC", "ADBC", "BDCA",
        "DCBA", "BACD", "BADC", "BDAC", "CBDA", "DBCA", "DCAB"
    ]

let complete = given.count + 1

uses_at(position: int, letter: char) -> int =>
    given |> count(word => word[position] == letter)

under_represented(position: int) -> char =>
    "ABCD"
        |> reduce(' ', (missing, letter) =>
            if uses_at(position, letter) < complete / 4 then
                letter
            else
                missing
            fi)

write_line(string(0..4 |> map(under_represented) |> collect()))
