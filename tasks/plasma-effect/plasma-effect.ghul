use System.Math
use Raster.IMAGE

let width = 480
let height = 360

plasma(x: double, y: double) -> double =>
    (Math.sin(x / 16.0D) +
     Math.sin(y / 8.0D) +
     Math.sin((x + y) / 16.0D) +
     Math.sin(Math.sqrt(x * x + y * y) / 8.0D) +
     4.0D) / 8.0D

channel(value: double, phase: double) -> ubyte =>
    cast ubyte(127.5D + 127.4D * Math.sin(Math.pi * (value * 5.0D + phase)))

let image = IMAGE(width, height)

for y in 0..height do
    for x in 0..width do
        let value = plasma(cast double(x), cast double(y))

        image.set_pixel(
            x, y,
            channel(value, 0.0D),
            channel(value, 2.0D / 3.0D),
            channel(value, 4.0D / 3.0D)
        )
    od
od

image.write("plasma.png")

image.show("plasma.png")
