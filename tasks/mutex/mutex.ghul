use IO.Std.write_line
use Ghul.Coroutines.COROUTINE
use Ghul.Coroutines.MUTEX
use Ghul.Coroutines.pause
use Ghul.Coroutines.run

let names = ["Alice", "Bob", "Carol"]

let console = MUTEX()

// The pause between the two lines yields to the other coroutines, so
// without the mutex the "enters" and "leaves" lines of different
// visitors interleave. Holding the mutex across the pause keeps each
// pair together.
visit(name: string) -> COROUTINE is
    write_line("{name} enters")
    await pause()
    write_line("{name} leaves")
si

guarded(name: string) -> COROUTINE is
    await console.acquire()
    await visit(name)
    console.release()
si

write_line("without the mutex")

for name in names do
    visit(name)
od

run()

write_line("")
write_line("with the mutex")

for name in names do
    guarded(name)
od

run()
