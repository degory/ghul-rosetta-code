use IO.Std.write_line;
use Collections.LIST;

let doors = LIST[bool]();

for i in 0..100 do
    doors.add(false);
od

for pass in 1::100 do
    let door mut = pass;

    while door <= 100 do
        doors[door - 1] = !doors[door - 1];
        door = door + pass;
    od
od

write_line("open doors:");

for door in 1::100 do
    if doors[door - 1] then
        write_line("{door}");
    fi
od
