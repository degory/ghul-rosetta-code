use IO.Std.write_line;
use Collections.LIST;
use Ghul.Pipes;

// ghūl has no variadic functions. A function that takes any number of values
// takes an array, and the caller writes an array literal at the call site.
print_all[T](values: T[]) is
    for value in values do
        write_line("{value}");
    od
si

class Animal(name: string) abstract is
    speak() -> string;

    to_string() -> string => "{name} says {speak()}";
si

class CAT(name: string): Animal is
    super(name);

    speak() -> string => "meow";
si

class DOG(name: string): Animal is
    super(name);

    speak() -> string => "woof";
si

herd(animals: Animal[]) is
    for animal in animals do
        write_line("{animal}");
    od
si

print_all(["one", 2, 3.5]);

// the element type of an array literal is inferred as the nearest type the
// elements have in common, so a literal mixing cats and dogs is an Animal[]
herd([CAT("felix"), DOG("rex")]);

let animals = LIST[Animal]();
animals.add(CAT("tom"));
animals.add(DOG("spot"));

// any array can be passed in
herd(animals |> collect_array());
