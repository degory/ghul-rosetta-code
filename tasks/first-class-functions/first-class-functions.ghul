use Ghul
use default
use System.Math.*

let cube = x => x * x * x
let cube_root = x => cbrt(x)

let functions = LIST()
functions.add(sin)
functions.add(cos)
functions.add(cube)

let inverses = LIST()
inverses.add(asin)
inverses.add(acos)
inverses.add(cube_root)

for (function, inverse) in functions |> zip(inverses) do
    let round_trip = function >> inverse

    write_line("{round_trip(0.5D):F6}")
od
