use IO.Std.write_line;

// Knuth's A, with the by-name arguments x1 to x5 written as functions, which is what call by name
// amounts to here. Each call to A gets its own k, and the B it builds captures that one: a `let
// mut` is captured by reference, so B decrements the k of the call it was made in, even when it
// is called long afterwards from somewhere further down.
a(k: int, x1: () -> int, x2: () -> int, x3: () -> int, x4: () -> int, x5: () -> int) -> int is
    let counter mut = k;

    let b = () rec =>
        val
            counter = counter - 1;

            a(counter, rec, x1, x2, x3, x4)
        lav;

    return if counter <= 0 then x4() + x5() else b() fi;
si

for k in 0::10 do
    write_line("k = {k,2}: {a(k, () => 1, () => -1, () => -1, () => 1, () => 0)}");
od
