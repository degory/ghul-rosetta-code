use IO.Std.write_line
use System.Math
use Ghul.Pipes.map
use Ghul.Pipes.reduce
use Ghul.Pipes.count

root_mean_square(values: Collections.List[double]) -> double is
    let squares =
        values
            |> map(v => v * v)
            |> reduce(0.0, (running, square) => running + square)

    return Math.sqrt(squares / cast double(values.count))
si

let one_to_ten = (1::10) |> map(n => cast double(n)) |> Ghul.Pipes.collect()

write_line("{root_mean_square(one_to_ten)}")
