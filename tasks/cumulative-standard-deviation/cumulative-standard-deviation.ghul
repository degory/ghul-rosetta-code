use IO.Std.write_line;
use System.Math.sqrt;

// A stateful closure, which is the most natural of the forms the task lists
// for this language: n, total and squares are captured by reference, so each
// call carries the running sums of every value seen so far.
let standard_deviation = val
    let n mut = 0;
    let total mut = 0.0D;
    let squares mut = 0.0D;

    (x: double) -> double is
        n = n + 1;
        total = total + x;
        squares = squares + x * x;

        let mean = total / cast double(n);

        sqrt(squares / cast double(n) - mean * mean)
    si
lav;

for x in [2.0D, 4.0D, 4.0D, 4.0D, 5.0D, 5.0D, 7.0D, 9.0D] do
    write_line("after {x}: {standard_deviation(x)}");
od
