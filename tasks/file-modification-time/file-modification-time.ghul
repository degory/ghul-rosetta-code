use default

let path = IO.Path.combine(IO.Path.get_temp_path(), "ghul-rosetta-mtime-test.txt")

IO.File.write_all_text(path, "hello")

let before = IO.File.get_last_write_time_utc(path)
let target = System.DateTime(2000, 1, 1, 0, 0, 0, System.DateTimeKind.UTC)

write_line("modification time before set is after year 2000: {before > target}")

IO.File.set_last_write_time_utc(path, target)

let after = IO.File.get_last_write_time_utc(path)

write_line("modification time now matches the value it was set to: {after =~ target}")

IO.File.delete(path)
