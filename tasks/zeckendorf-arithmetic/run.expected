counting:
  1
  10
  100
  101
  1000
  1001
  1010
  10000
  10001
  10010
  10100
  10101

addition:
  1 + 1 = 10
  10 + 10 = 101
  100 + 100 = 1001
  1000 + 1000 = 10010
  10100 + 1001 = 100101

subtraction:
  10100 - 1000 = 1001
  100100 - 1000 = 10100
  1000100 - 101 = 101010

multiplication:
  101 * 1001 = 1000100
  1000 * 1000 = 1000101
  10 * 10101 = 1000100

division:
  1000101 / 101 = 1001 remainder 1
  1000100 / 101 = 1001 remainder 0
  101010 / 10 = 10010 remainder 0
