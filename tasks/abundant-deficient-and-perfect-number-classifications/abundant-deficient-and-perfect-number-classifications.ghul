use IO.Std.write_line
use Collections.LIST

let limit = 20000

// A sieve costs one pass over each divisor's multiples, where testing each
// number separately would cost a division for every candidate divisor.
let proper_divisor_sums = LIST()

for _ in 0::limit do
    proper_divisor_sums.add(0)
od

for divisor in 1::limit / 2 do
    let multiple mut = divisor * 2

    while multiple <= limit do
        proper_divisor_sums[multiple] =
            proper_divisor_sums[multiple] + divisor

        multiple = multiple + divisor
    od
od

let deficient mut = 0
let perfect mut = 0
let abundant mut = 0

for n in 1::limit do
    let sum = proper_divisor_sums[n]

    if sum < n then
        deficient = deficient + 1
    elif sum == n then
        perfect = perfect + 1
    else
        abundant = abundant + 1
    fi
od

write_line("of 1 to {limit}:")
write_line("  deficient {deficient}")
write_line("  perfect   {perfect}")
write_line("  abundant  {abundant}")
