use default

let limit = 20000

let proper_divisor_sums = repeat(0, limit + 1) |> collect_mutable()

for divisor in 1::limit / 2 do
    let multiple mut = divisor * 2

    while multiple <= limit do
        proper_divisor_sums[multiple] =
            proper_divisor_sums[multiple] + divisor

        multiple = multiple + divisor
    od
od

let deficient mut = 0
let perfect mut = 0
let abundant mut = 0

for n in 1::limit do
    let sum = proper_divisor_sums[n]

    if sum < n then
        deficient = deficient + 1
    elif sum == n then
        perfect = perfect + 1
    else
        abundant = abundant + 1
    fi
od

write_line("of 1 to {limit}:")
write_line("  deficient {deficient}")
write_line("  perfect   {perfect}")
write_line("  abundant  {abundant}")
