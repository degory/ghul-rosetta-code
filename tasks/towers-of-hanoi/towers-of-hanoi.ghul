use IO.Std.write_line;

move(disks: int, source: int, target: int, spare: int) is
    if disks == 0 then
        return;
    fi

    move(disks - 1, source, spare, target);
    write_line("move a disk from pole {source} to pole {target}");
    move(disks - 1, spare, target, source);
si

move(3, 1, 3, 2);
