-0.0                         -0
1.0 / 0.0                    Infinity
-1.0 / 0.0                   -Infinity
0.0 / 0.0                    NaN

double.negative_infinity     -Infinity
double.positive_infinity     Infinity
double.na_n                  NaN

-0.0 == 0.0                  True
1.0 / -0.0                   -Infinity
nan == nan                   False
double.is_na_n(nan)          True

infinity + 1.0               Infinity
infinity - infinity          NaN
infinity * 0.0               NaN
1.0 / infinity               0
