use IO.Std.write_line
use Ghul.Pipes
use System.Numerics.BigInteger

difference(exponent: int, a: int, b: int) -> BigInteger =>
    BigInteger.pow(BigInteger(a), exponent) -
    BigInteger.pow(BigInteger(b), exponent)

zsigmondy(exponent: int, a: int, b: int) -> BigInteger is
    let greatest mut = difference(exponent, a, b)

    for lesser in 1..exponent do
        let smaller = difference(lesser, a, b)
        let common mut =
            BigInteger.greatest_common_divisor(greatest, smaller)

        while common > BigInteger.one do
            greatest = greatest / common
            common = BigInteger.greatest_common_divisor(greatest, smaller)
        od
    od

    greatest
si

let radices =
    [(2, 1), (3, 1), (4, 1), (5, 1), (6, 1),
     (7, 1), (3, 2), (5, 3), (7, 3), (7, 5)]

write_line("Zsigmondy numbers, the first twenty of each sequence:")

for radix in radices do
    let terms =
        (1::20) |> map(n => "{zsigmondy(n, radix.`0, radix.`1)}")
                |> join(" ")

    write_line("")
    write_line("a = {radix.`0}, b = {radix.`1}")
    write_line("  {terms}")
od
