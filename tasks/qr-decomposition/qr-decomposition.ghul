use default

use Rows = List[List[double]]
use Table = LIST[LIST[double]]

zeros(rows: int, columns: int) -> Table =>
    0..rows
        |> map(_ => repeat(0.0, columns) |> collect_mutable())
        |> collect_mutable()

identity(size: int) -> Table is
    let result = zeros(size, size)

    for i in 0..size do
        result[i][i] = 1.0
    od

    result
si

multiply(a: Rows, b: Rows) -> Table is
    let result = zeros(a.count, b[0].count)

    for i in 0..a.count do
        for j in 0..b[0].count do
            result[i][j] =
                0..b.count |> map(k => a[i][k] * b[k][j]) |> sum()
        od
    od

    result
si

transpose(a: Rows) -> Table =>
    0..a[0].count
        |> map(j => 0..a.count |> map(i => a[i][j]) |> collect_mutable())
        |> collect_mutable()

householder(a: Rows, k: int) -> Table is
    let m = a.count
    let column = k..m |> map(i => a[i][k]) |> collect_mutable()
    let norm = System.Math.sqrt(column |> map(x => x * x) |> sum())
    let sign = if column[0] < 0.0 then -1.0 else 1.0 fi
    let first = column[0] + sign * norm
    let v = 0..column.count
        |> map(i => if i == 0 then 1.0 else column[i] / first fi)
        |> collect_mutable()
    let beta = 2.0 / (v |> map(x => x * x) |> sum())
    let h = identity(m)

    for i in 0..v.count do
        for j in 0..v.count do
            h[k + i][k + j] = h[k + i][k + j] - beta * v[i] * v[j]
        od
    od

    h
si

decompose(a: Rows) -> (q: Table, r: Table) is
    let m = a.count
    let n = a[0].count
    let q mut = identity(m)
    let r mut = multiply(a, identity(n))

    for k in 0..(if m - 1 < n then m - 1 else n fi) do
        let h = householder(r, k)

        q = multiply(q, h)
        r = multiply(h, r)
    od

    (q, r)
si

least_squares(a: Rows, b: List[double]) -> List[double] is
    let (q, r) = decompose(a)
    let n = a[0].count
    let column = b |> map(y => LIST([y])) |> collect_mutable()
    let qtb = multiply(transpose(q), column)
    let x = repeat(0.0, n) |> collect_mutable()

    for i in (0..n) |> reverse() do
        let known = i + 1..n |> map(j => r[i][j] * x[j]) |> sum()

        x[i] = (qtb[i][0] - known) / r[i][i]
    od

    x
si

show(name: string, matrix: Rows) is
    write_line("{name}:")

    for row in matrix do
        write_line(row |> map(x => "{x,10:F3}") |> join(""))
    od

    write_line("")
si

let a = [[12.0, -51.0, 4.0], [6.0, 167.0, -68.0], [-4.0, 24.0, -41.0]]
    |> map(row => LIST(row)) |> collect_mutable()

let (q, r) = decompose(a)

show("Q", q)
show("R", r)
show("Q R", multiply(q, r))

let xs = 0::10 |> map(x => cast double(x)) |> collect_mutable()
let ys = [
    1.0, 6.0, 17.0, 34.0, 57.0, 86.0, 121.0, 162.0, 209.0, 262.0, 321.0
]
let design = xs |> map(x => LIST([1.0, x, x * x])) |> collect_mutable()

let fit = least_squares(design, LIST(ys))

write_line("Fitting y = a + bx + cx² to the polynomial regression data:")
write_line(fit |> map(c => "{c:F6}") |> join("  "))
