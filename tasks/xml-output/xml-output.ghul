use default
use System.Xml.Linq

character(name: string, remark: string) -> XElement =>
    XElement(
        XName.get("Character"),
        [XAttribute(XName.get("name"), name), remark])

remarks_document(remarks: List[(name: string, remark: string)]) -> XDocument =>
    XDocument(
        [XElement(
            XName.get("CharacterRemarks"),
            remarks
                |> map(((name, remark)) => character(name, remark))
                |> collect_array())])

let remarks =
    [
        (name = "April", remark = "Bubbly: I'm > Tam and <= Emily"),
        (name = "Tam O'Shanter",
         remark = "Burns: \"When chapman billies leave the street ...\""),
        (name = "Emily", remark = "Short & shrift")
    ]

write_line("{remarks_document(remarks)}")
