use IO.Std.write_line
use Collections.LIST
use Ghul.Pipes.join

transpose(matrix: LIST[LIST[int]]) -> LIST[LIST[int]] is
    let columns = LIST[LIST[int]]()

    for column in 0..matrix[0].count do
        let row = LIST[int]()

        for source in matrix do
            row.add(source[column])
        od

        columns.add(row)
    od

    columns
si

show(caption: string, matrix: LIST[LIST[int]]) is
    write_line(caption)

    for row in matrix do
        write_line("  {row |> join(" ")}")
    od
si

let matrix = LIST([
    LIST([1, 2, 3, 4]),
    LIST([5, 6, 7, 8]),
    LIST([9, 10, 11, 12])
])

show("original", matrix)
show("transposed", transpose(matrix))
