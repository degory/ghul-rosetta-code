use IO.Std.write_line;

bits(n: int) -> string => System.Convert.to_string(n, 2).pad_left(5, '0');

encode(n: int) -> int => n ^ (n >>> 1);

// each bit of the decoded value is the parity of that bit and every bit above
// it, so the shifts of the Gray code are folded in one at a time
decode(gray: int) -> int =>
    val
        let n mut = gray;

        for shift in 1..5 do
            n = n ^ (gray >>> shift);
        od;

        n
    lav;

write_line("binary  gray   decoded");

for n in 0::31 do
    let gray = encode(n);

    write_line("{bits(n)}   {bits(gray)}   {decode(gray)}");
od
