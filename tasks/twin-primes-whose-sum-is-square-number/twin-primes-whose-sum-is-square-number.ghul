use IO.Std.write_line
use Collections.LIST
use Ghul.Pipes

let limit = 10_000_000
let composite = LIST[bool]()

for _ in 0::limit do
    composite.add(false)
od

let factor mut = 2

while factor * factor <= limit do
    if !composite[factor] then
        let multiple mut = factor * factor

        while multiple <= limit do
            composite[multiple] = true
            multiple = multiple + factor
        od
    fi

    factor = factor + 1
od

is_prime(value: int) -> bool => value > 1 /\ !composite[value]

is_square(value: int) -> bool =>
    (let root = cast int(System.Math.sqrt(cast double(value))) in
     (root - 1::root + 1) |> any(candidate => candidate * candidate == value))

write_line("twin primes below ten million whose sum is a square:")

for lower in 2::limit - 2 do
    if is_prime(lower) /\ is_prime(lower + 2) /\ is_square(lower * 2 + 2) then
        let root = cast int(System.Math.sqrt(cast double(lower * 2 + 2)))

        write_line("  {lower} and {lower + 2} sum to {lower * 2 + 2}, "
                   "which is {root} squared")
    fi
od
