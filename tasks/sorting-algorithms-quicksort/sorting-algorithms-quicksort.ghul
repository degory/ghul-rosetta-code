use IO.Std.write_line;
use Collections.List;
use Ghul.Pipes;

quicksort[T: Ghul.Comparable[T]](values: List[T]) -> List[T] =>
    if values.count <= 1 then
        values
    else
        val
            let pivot = values[0];
            let rest = values |> skip(1) |> collect();

            let below = rest |> filter(v => v < pivot) |> collect();
            let above = rest |> filter(v => v >= pivot) |> collect();

            quicksort(below)
                |> cat([pivot])
                |> cat(quicksort(above))
                |> collect()
        lav
    fi;

write_line("{$quicksort([6, 2, 9, 2, 5, 1, 8, 3] |> collect())}");
write_line("{$quicksort(["pear", "apple", "fig", "date"] |> collect())}");
