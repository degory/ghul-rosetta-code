use IO.Std.write_line
use Collections.LIST
use Ghul.Pipes.join

use Matrix = LIST[LIST[int]]

multiply(left: Matrix, right: Matrix) -> Matrix is
    assert left[0].count == right.count else "shapes do not conform"

    let product = LIST[LIST[int]]()

    for row in left do
        let out = LIST[int]()

        for column in 0..right[0].count do
            let total mut = 0

            for i in 0..right.count do
                total = total + row[i] * right[i][column]
            od

            out.add(total)
        od

        product.add(out)
    od

    product
si

let a = LIST([LIST([1, 2]), LIST([3, 4]), LIST([5, 6])])
let b = LIST([LIST([1, 2, 3]), LIST([4, 5, 6])])

for row in multiply(a, b) do
    write_line(row |> join(" "))
od
