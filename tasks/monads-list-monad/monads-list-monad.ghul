use IO.Std.write_line
use Collections.Iterable
use Ghul.Pipes
use System.Convert.to_string

pure[T](value: T) -> Iterable[T] => [value]

bind[T, U](values: Iterable[T], f: (T) -> Iterable[U] pure)
    -> Iterable[U]
=>
    values |> flat_map(f)

let divisors = (n: int) -> Iterable[int] =>
    (1::n) |> filter(d => n % d == 0)

let spellings = (n: int) -> Iterable[string] =>
    ["{n}", "0b{to_string(n, 2)}"]

write_line(pure(6) |> bind(divisors) |> join(", "))
write_line(pure(6) |> bind(divisors) |> bind(spellings) |> join(", "))
