use default

// A string compared with == is compared by identity, not by
// its characters. Two literals spelled the same are usually the
// same object, so the mistake hides until one of them is built
// at run time.
let literal = "hello"
let built = "{"hel"}{"lo"}"

write_line("== says {literal == built}")
write_line("=~ says {literal =~ built}")

// Two string literals with nothing between them but white space
// are one literal. A missing comma in a list of strings does not
// fail to compile: it joins two of the elements.
let colours = [
    "red"
    "green",
    "blue"
]

write_line("{colours.count} colours: {colours}")

// byte is signed and ubyte is unsigned, the other way round from
// .NET's names for the same two types.
write_line("byte {cast byte(200)}, ubyte {cast ubyte(200)}")

// A pipe is a cursor over its source. Reading it part way and
// then reading it again carries on from where the last read
// stopped, and it only starts over once it has run out.
let evens = [1, 2, 3, 4, 5, 6] |> filter(x => x % 2 == 0)

write_line("first even: {evens |> first()}")

for e in evens do
    write_line("next even: {e}")
od

write_line("all evens: {evens |> collect_list()}")
