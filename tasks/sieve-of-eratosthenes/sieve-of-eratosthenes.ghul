use IO.Std.write_line;
use Collections.LIST;
use Ghul.Pipes;

sieve(limit: int) -> LIST[int] is
    let composite = LIST[bool]();

    (0::limit) |> each(_ => composite.add(false));

    let p mut = 2;

    while p * p <= limit do
        if !composite[p] then
            let multiple mut = p * p;

            while multiple <= limit do
                composite[multiple] = true;
                multiple = multiple + p;
            od
        fi

        p = p + 1;
    od

    let primes = LIST[int]();

    (2::limit) |> each(i -> void => if !composite[i] then primes.add(i) fi);

    return primes;
si

for p in sieve(100) do
    write_line("{p}");
od
