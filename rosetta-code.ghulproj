<Project Sdk="Microsoft.NET.Sdk">
  <!-- This project exists only so the ghūl VS Code extension loads every task's source in one
       analysis session, and can find the reference assemblies. Every task file carries its own
       top-level statements, so this project's build reports one per file, which no build here
       is meant to run: suppressed below rather than fixed, since running one task from among
       hundreds is not what this project is for. Build and run each task from its own folder
       under tasks/. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler --entry root_entry</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="tasks/**/*.ghul" />
    <GhulSources Include="root/**/*.ghul" />

    <!-- Every task is a whole program, so in this aggregate all but one
         file's top-level statements are unreachable, and the analysis
         session would otherwise report one warning per task. The pipe
         combinators take pure functions, which a call to write_line or
         a string interpolation is not. -->
    <GhulOptions Include="--suppress top-level-statements-not-run" />
    <GhulOptions Include="--suppress impure-function-argument" />

    <!-- Terminator-free sources; error on CI so stray `;` cannot creep
         back in, warning locally. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" Condition="'$(CI)' != ''" />
    <GhulOptions Include="--suppress top-level-statements-not-run" />
  </ItemGroup>
</Project>
