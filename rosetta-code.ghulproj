<Project Sdk="Microsoft.NET.Sdk">
  <!-- This project exists only so the ghūl VS Code extension loads every task's source in one
       analysis session, and can find the reference assemblies. It is deliberately not buildable:
       each task is a program in its own right, so compiling them together reports duplicate entry
       points. Build and run each task from its own folder under tasks/. -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GhulCompiler>dotnet ghul-compiler --entry root_entry</GhulCompiler>
  </PropertyGroup>

  <ItemGroup>
    <GhulSources Include="tasks/**/*.ghul" />
    <GhulSources Include="root/**/*.ghul" />

    <!-- Terminator-free sources; error on CI so stray `;` cannot creep
         back in, warning locally. -->
    <GhulOptions Include="--warn redundant-semicolon" />
    <GhulOptions Include="--warn-as-error redundant-semicolon" Condition="'$(CI)' != ''" />
  </ItemGroup>
</Project>
